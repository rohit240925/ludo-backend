PORT=3000
CORS_ORIGIN=*
# Optional — the server runs fine WITHOUT MongoDB (rooms are in-memory).
# Persistence (match history) is best-effort and only activates when this is set.
# MONGODB_URI=mongodb://127.0.0.1:27017/ludo

# Admin API secret. Empty/missing = admin endpoints are disabled
# (they answer 403 {code:'ADMIN_DISABLED'}).
# ADMIN_TOKEN=choose-a-long-random-secret-here
